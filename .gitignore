# =============================================================
# DivisionX Card — .gitignore
# =============================================================

# ─── Environment (ห้าม commit เด็ดขาด!) ─────────────────────
.env
.env.local
.env.development
.env.production
.env.staging
*.env

# ─── Google Cloud service account keys (ห้าม commit เด็ดขาด!) ─
Stock-Management-/
*-iam.gserviceaccount.com*.json
**/service-account*.json
**/nice-limiter-*.json

# ─── Dependencies ────────────────────────────────────────────
node_modules/
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ─── Generated staging (Loop 2 content suggestions · regenerate ทุกสัปดาห์) ─
deploy/tasks/content_suggestions.json

# ─── Build Output ────────────────────────────────────────────
.next/
dist/
build/
out/
*.tsbuildinfo

# ─── Logs ────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*

# ─── OS / Editor ─────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ─── Obsidian (commit wiki/ แต่ไม่ commit user workspace) ────
wiki/.obsidian/workspace*
wiki/.obsidian/cache
wiki/.obsidian/graph.json
wiki/.trash/

# ─── VMS Scraper ─────────────────────────────────────────────
scripts/vms-scraper/cookies.json
scripts/vms-scraper/session.json
scripts/vms-scraper/*.png
scripts/vms-scraper/*.har

# ─── Database dumps ──────────────────────────────────────────
*.sql.gz
*.dump

# ─── ไฟล์สำรองฐานข้อมูลรายสัปดาห์ (บอทในเครื่องเป็นคนทำ ตั้งแต่ 16 ก.ย. 2026) ──
# อยู่ที่รากรีโป **นอก deploy/** โดยตั้งใจ — scripts/vercel_deploy.py อัปทุกอย่างใน deploy/
# ขึ้นเว็บ ถ้าวางไว้ที่นั่น ไฟล์ที่มียอดขายทั้งบริษัทจะโหลดได้จากอินเทอร์เน็ต
/backups/

.vercel

# ─── Local dashboard launcher (machine-specific paths) ───────
dashboard.bat

# ─── Secrets dropped in repo root (service keys / passwords) ──
Supabase Data.txt

# ─── Analysis scripts ที่ฝัง service key (อย่า commit) ────────
scripts/gap_analysis.mjs
scripts/sellthrough_chukes01.mjs

# ─── Video source (โฮสต์บน Supabase Storage แล้ว · ไฟล์ใหญ่) ──
/Video/

# ─── รูปต้นฉบับ (807MB · โฮสต์บน Supabase Storage แล้ว) ───────
# นำหน้าด้วย / เพื่อผูกกับ root เท่านั้น — เดิมเขียน image/ เฉย ๆ ทำให้โดน
# ทุกโฟลเดอร์ชื่อ image ทั่วโปรเจกต์ (route /api/marketing/content/image หายไปเงียบ ๆ)
/image/

# ─── Claude Code local (worktrees + settings เฉพาะเครื่อง) ────
.claude/settings.local.json
.claude/worktrees/

# ─── Obsidian scratch (ไฟล์ Untitled ที่เผลอสร้าง) ────────────
wiki/Untitled*

# ─── เอกสารอ้างอิงจากคู่ค้า / ไฟล์งานแอดมิน (ไบนารีก้อนใหญ่) ──
คู่มือ - พัฒนาโปรแกรม POS สำหรับตู้ Vending/
*.xlsx
deploy/docs/*.zip

# โมเดลภาพบนเครื่อง (SDXL) — ใหญ่หลาย GB ห้ามเข้า git
.venv-image/

# ?????? FLUX ????????????? � ??????????????????????
deploy/.scenes/

# แคชหน้ารายละเอียดการ์ด — ดึงใหม่ได้ ไม่ต้องเก็บเข้า repo
deploy/agents/.cache/

# เอกสารอ้างอิงขนาดใหญ่ (64 MB) — เก็บไว้ในเครื่องเท่านั้น ห้ามเข้า repo
docs/

# venv ของ MCP server — สร้างใหม่ได้ ไม่ต้องเข้า repo
.venv-mcp/

# ─── เศษไฟล์ทดลองที่เผลอทิ้งไว้ (เคยค้าง 47 ไฟล์ 12 วัน · 9 ก.ย. 2026) ──
# `nul` เกิดจาก redirect แบบ Windows (`> nul`) ใน Git Bash ซึ่งสร้างไฟล์จริง
# ไม่ใช่ /dev/null · ใน Bash tool ให้ใช้ `> /dev/null`
nul
temp/
deploy/agents/temp/
tmp_*
temp_*.py

# งานระหว่างทำของโรงงานวิดีโอ — ไฟล์สื่อก้อนใหญ่ สร้างใหม่ได้จากไฟล์แผน
.video-work/

# ─── เพลงประกอบวิดีโอ (ไฟล์เสียงมีลิขสิทธิ์ · ห้ามเข้า repo) ──────
# ใบอนุญาตเพลงผูกกับ "ผู้ซื้อ" ไม่ใช่ทุกคนที่ clone repo ได้ — commit ไฟล์เพลง
# คือการแจกจ่ายซ้ำ ผิดสัญญาตั้งแต่วันที่ commit
# ไฟล์อยู่ที่ deploy/assets/ ไม่ใช่ deploy/public/ **โดยตั้งใจ** — public/ ถูก Next.js
# เสิร์ฟสาธารณะ ถ้าวางไว้ที่นั่นแล้วบรรทัดนี้พลาดเมื่อไหร่ ไฟล์จะขึ้น Vercel แล้ว
# โหลดได้จาก /music/xxx.mp3 ทันที (repo นี้เคยเขียนกฎ gitignore พลาดมาแล้ว —
# ดูบันทึกที่บรรทัด /image/) · บรรทัด public/music/ ยังอยู่เผื่อของเก่าที่เผลอวางไว้
# รายการเพลง (คีย์ อารมณ์ ใบอนุญาต) เก็บใน deploy/tasks/video_music.json ซึ่ง commit ตามปกติ
deploy/assets/music/
deploy/public/music/

# ?????????????????????????? (????????????)
scripts/.sync_bot_state.json
.sync-local.log
.sync-local.pid
