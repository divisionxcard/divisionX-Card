# ================================================================
# DivisionX Card — Environment Variables
# คัดลอกไฟล์นี้เป็น .env.local แล้วกรอกค่าจริง
# ================================================================

# Supabase (ดูได้จาก Supabase Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── AI สำหรับหน้า /marketing ──
# เขียนแคปชั่น (ฟรี มีโควตารายวัน)
GEMINI_API_KEY=

# สร้างภาพโปสเตอร์ + ตรวจปรู๊ฟ — ต้องเติมเครดิตเอง ไม่มี free tier
# ⚠️ ChatGPT Plus ที่จ่ายรายเดือนใช้กับ API ไม่ได้ คนละบิลคนละระบบ
OPENAI_API_KEY=

# อ่านยอดค่าใช้จ่ายมาแสดงเป็น "เครดิตคงเหลือ" บนหัวหน้า /marketing
#
# ⚠️ ต้องเป็น **Admin key** (ขึ้นต้น sk-admin-) — คนละตัวกับ OPENAI_API_KEY ข้างบน
#    สร้างที่ platform.openai.com/settings/organization/admin-keys
#    เป็นเมนู "Admin keys" ในแถบซ้าย **คนละหน้ากับ "API keys"** (พลาดตรงนี้มาแล้ว 28 ส.ค. 2026)
#    ต้องเป็น Organization Owner ถึงจะเห็นเมนูนี้
#    key แบบ sk-proj- เรียกโมเดลได้แต่อ่านค่าใช้จ่ายไม่ได้ (403 missing scope api.usage.read)
#    และ Admin key เรียกโมเดลไม่ได้ ห้ามเอาไปทับ OPENAI_API_KEY
#
# ไม่ตั้งค่าก็ใช้หน้าเว็บได้ปกติ แค่ป้ายเครดิตจะขึ้นว่ายังไม่ได้ตั้งค่า
OPENAI_ADMIN_KEY=
